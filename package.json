{
  "name": "gist-viewer-vue",
  "version": "1.2.0",
  "description": "A Vue 3 component for embedding GitHub Gists with syntax highlighting, line numbers, and a copy button.",
  "license": "MIT",
  "author": {
    "name": "Darshit Dudhaiya",
    "email": "darshitdudhaiya201@gmail.com",
    "url": "https://github.com/darshitdudhaiya"
  },
  "homepage": "https://github.com/darshitdudhaiya/gist-viewer-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshitdudhaiya/gist-viewer-vue.git"
  },
  "bugs": {
    "url": "https://github.com/darshitdudhaiya/gist-viewer-vue/issues"
  },
  "type": "module",
  "main": "./dist/gist-viewer-vue.umd.cjs",
  "module": "./dist/gist-viewer-vue.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/gist-viewer-vue.js",
      "require": "./dist/gist-viewer-vue.umd.cjs"
    },
    "./style.css": "./dist/gist-viewer-vue.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "types",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "gist",
    "github",
    "github-gist",
    "embed",
    "syntax-highlighting",
    "code-block",
    "component",
    "nuxt",
    "vitepress"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
